  {"o":"function lrPie(","n":"function lrTxChart(M){const W=340,H=190,pl=42,pb=24,pt=10,ch=H-pb-pt,mx=Math.max(1,...M.map(x=>x.n)),gw=(W-pl-6)/M.length,y=v=>pt+ch*(1-v/mx);let s=`<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto\">`;for(let i=0;i<=3;i++){const v=mx*i/3,yy=y(v);s+=`<line x1=\"${pl}\" x2=\"${W}\" y1=\"${yy}\" y2=\"${yy}\" stroke=\"var(--bd)\" stroke-dasharray=\"3 3\"/><text x=\"${pl-5}\" y=\"${yy+3}\" font-size=\"9\" text-anchor=\"end\" fill=\"var(--mut)\">${Math.round(v)}</text>`}const P=M.map((m,i)=>[pl+i*gw+gw/2,y(m.n)]);s+=`<polyline fill=\"none\" stroke=\"var(--pri)\" stroke-width=\"2.5\" points=\"${P.map(p=>p.join(\",\")).join(\" \")}\"></polyline>`+P.map((p,i)=>`<circle cx=\"${p[0]}\" cy=\"${p[1]}\" r=\"3\" fill=\"var(--card)\" stroke=\"var(--pri)\" stroke-width=\"2\"><title>${M[i].l}: ${M[i].n} transaksi</title></circle>`).join(\"\");M.forEach((m,i)=>{s+=`<text x=\"${pl+i*gw+gw/2}\" y=\"${H-8}\" font-size=\"10\" text-anchor=\"middle\" fill=\"var(--mut)\">${m.l}</text>`});return s+`</svg><div class=\"row\" style=\"justify-content:center;gap:8px;font-size:12px\"><span style=\"color:var(--pri)\">● Jumlah transaksi per bulan</span></div>`}\nfunction lrPie("},
