[{"o": "<div class=\"card\" style=\"margin-top:12px\"><h2>Penjualan 7 hari</h2><div class=\"row\" style=\"align-items:flex-end;height:120px;gap:6px\">${days.map(([d,v])=>`<div style=\"flex:1;text-align:center\"><div style=\"background:var(--pri);height:${Math.round(v/mx*90)}px;border-radius:4px 4px 0 0;min-height:2px\"></div><div class=\"mut\">${d.slice(8)}/${d.slice(5,7)}</div></div>`).join(\"\")}</div></div>", "n": "<div class=\"card\" style=\"margin-top:12px\"><h2>Penjualan 7 hari</h2><div class=\"row\" style=\"align-items:flex-end;height:150px;gap:6px\">${days.map(([d,v])=>`<div style=\"flex:1;text-align:center;min-width:0\"><div style=\"font-size:10px;font-weight:700;color:var(--pri);white-space:nowrap\">${v?lrF(v):\"\"}</div><div style=\"background:var(--pri);height:${Math.round(v/mx*90)}px;border-radius:4px 4px 0 0;min-height:2px\"></div><div class=\"mut\">${d.slice(8)}/${d.slice(5,7)}</div></div>`).join(\"\")}</div>\n <div style=\"margin-top:10px\">${days.slice().reverse().map(([d,v])=>`<div class=\"row sp item\" style=\"min-height:40px;padding:6px 0\"><span>${lpD(d).slice(0,5)}<span class=\"mut\"> · ${db.tx.filter(t=>t.date===d).length} transaksi</span></span><b style=\"color:var(--pri)\">${rp(v)}</b></div>`).join(\"\")}<div class=\"row sp\" style=\"padding-top:8px;border-top:1px solid var(--bd)\"><b>Total 7 hari</b><b class=\"tot\" style=\"font-size:18px\">${rp(days.reduce((s,x)=>s+x[1],0))}</b></div></div></div>"}, {"o": "const APP_VERSION=\"v10\"", "n": "const APP_VERSION=\"v11\""}]